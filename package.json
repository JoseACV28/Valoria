{
  "name": "histopad",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm run build --workspace client",
    "start": "npm --workspace server run start",
    "test": "npm --workspace server run test && npm --workspace client run test",
    "qa:local": "node scripts/qa.mjs --local",
    "qa:staging": "node scripts/qa.mjs",
    "qa:check": "node scripts/qa.mjs --check",
    "qa:database": "node server/scripts/createQaDatabase.mjs"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "dependencies": {
    "express": "4.22.1"
  }
}
