PORT=4000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=story-media
UPLOAD_FALLBACK_DIR=uploads
SITE_OWNER_ID=c9f926b5-b052-4e76-9af0-2f11f016a93e

# Daily private backups while the server is running
SITE_BACKUP_ENABLED=true
# Optional AES-256-GCM encryption: 64 hex characters, generated privately.
# Keep a recovery copy of this key outside the computer and backup folder.
BACKUP_ENCRYPTION_KEY=
# Set the exact public frontend origins for deployment
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Hosting: set NODE_ENV=production and replace CORS_ORIGINS with exact HTTPS origins.
# Production startup refuses missing Supabase keys or a missing owner UUID.
# The development IP limiter is per process; configure a trusted proxy and shared
# rate limiting before serving public traffic. Never trust arbitrary forwarded IPs.

# Enable after applying 20261006_session_security.sql.
# Both controls are mandatory in NODE_ENV=production regardless of these flags.
SESSION_CHECK_REQUIRED=false
ADMIN_MFA_REQUIRED=false

# Public work URLs and sharing previews: replace with your final HTTPS domain.
PUBLIC_SITE_URL=http://localhost:5174
# Optional private HTTPS webhook for operational alerts. Never put it in VITE_*.
OPERATIONS_WEBHOOK_URL=
# Independent hosting monitor: node --env-file=.env scripts/monitorOperations.mjs
# Run it from a separate scheduler so it can detect a stopped API.
OPERATIONS_HEALTH_URL=http://127.0.0.1:4000/api/health
